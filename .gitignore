# Claude Code conversation history — never commit (private + too large)
*.jsonl

# .claude-context/ is intentionally NOT gitignored — it's the sync feature
# Only exclude the conversation history files inside it if they ever appear:
.claude-context/*.jsonl
.claude-context/*.json
!.claude-context/sync-manifest.json

# examples/ is intentionally NOT gitignored — it shows what /scaffold generates
# Re-include the files we'd normally hide, but only inside examples/:
!examples/**/.vscode/
!examples/**/.vscode/*
!examples/**/CLAUDE.md
